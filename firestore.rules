rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com"; }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.carrierUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.approvalStatus == 'approved'
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.status == 'online'
          && resource.data.carrierUid == null) ||
        isAdmin()
      );

      // Acceptance, stage transitions and PIN completion are server-only callables.
      // A partner may only send rate-limited location projections for their assigned order.
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid
          && resource.data.status in ['New Order', 'Confirmed']
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'statusNote', 'cancellationReason', 'updatedAt'
          ]))
        || (signedIn() && resource.data.carrierUid == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.carrierUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'carrierLat','carrierLng','carrierLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]));

      allow delete: if false;
    }


    match /rideBookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','status',
            'cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status == 'Cancelled'
          ))
        || (signedIn() && resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','partnerAccepted','acceptedAt','rejectedAt','partnerLat','partnerLng',
            'partnerLocationUpdatedAt','cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && request.resource.data.status in ['pending_acceptance','Accepted','Rejected','Cancelled']);
      allow delete: if false;
    }

    match /autoRideRequests/{requestId} {
      function onlineRidePartner() {
        return signedIn()
          && exists(/databases/$(database)/documents/ridePartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.status == 'online'
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.get('rideVehicleType',
            get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.get('vehicleType', '')) in [
              'bike','auto','car','two_wheeler','motorcycle','Motorcycle','scooter','Scooter',
              'e-bike','E-bike','auto rickshaw','Auto Rickshaw','e-rickshaw','E-Rickshaw',
              'sedan','Sedan','hatchback','Hatchback','suv','SUV','muv','MUV','taxi / cab','Taxi / Cab'
            ];
      }

      // New requests are customer-owned; server-side Functions own acceptance,
      // ride start, completion and expiry transitions.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.rejectedBy is list
        && request.resource.data.confirmationPin is string
        && request.resource.data.confirmationPin.matches('^[0-9]{4}$')
        && request.resource.data.ridePinVerified == false;

      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.driverUid == request.auth.uid ||
        resource.data.carrierUid == request.auth.uid ||
        isAdmin() ||
        (onlineRidePartner()
          && resource.data.status == 'searching'
          && resource.data.get('driverUid', null) == null
          && resource.data.get('carrierUid', null) == null
          && !(request.auth.uid in resource.data.get('rejectedBy', [])))
      );

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','cancelledBy','cancellationReason','cancelledAt',
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt',
            'customerActive','expiredAt'
          ])
          && request.resource.data.status in ['searching','requested','accepted','assigned','arriving','arrived','started','cancelled','expired']
          && (
            request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'cancelled'
              && resource.data.status in ['searching','requested','accepted','assigned','arriving','arrived','started']
              && request.resource.data.get('cancelledBy', '') == 'customer')
            || (request.resource.data.status == 'expired'
              && resource.data.status in ['searching','requested']
              && resource.data.get('expiresAt', null) is timestamp
              && resource.data.expiresAt <= request.time)
          ))
        || (signedIn()
          && (resource.data.driverUid == request.auth.uid || resource.data.carrierUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','driverLat','driverLng','driverLocationUpdatedAt','rejectedBy','updatedAt',
            'cancelledBy','cancellationReason','cancelledAt'
          ])
          && request.resource.data.status in ['accepted','arrived','started','cancelled']
          && (
            request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'cancelled'
              && resource.data.status in ['accepted','arrived','started']
              && request.resource.data.get('cancelledBy', '') == 'partner')
          ))
        || (onlineRidePartner()
          && resource.data.status == 'searching'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejectedBy','updatedAt'])
          && request.resource.data.rejectedBy is list);

      allow delete: if false;
    }

    match /vehicleBookings/{bookingId} {
      // New vehicle bookings must go through createVehicleBooking so availability
      // and reservation status are updated atomically by a trusted server.
      allow create: if false;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && resource.data.status in ['Booked','booked','Pending','pending','Requested','requested','Confirmed','confirmed','Accepted','accepted','in review']
          && request.resource.data.status in ['Cancelled','cancelled']
          && request.resource.data.cancellationReason is string
          && request.resource.data.cancellationReason.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ]))
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerLat','ownerLng','ownerLocationUpdatedAt','status','updatedAt'
          ])
          && request.resource.data.status in ['Booked','Accepted','Rejected','Cancelled','delivered']);
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      // Listings are public, so private contact and precise location must never
      // be written into this collection. Keep those values in vehicleOwnerContacts.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny([
          'ownerPhone','latitude','longitude','currentLocation','ownerLat','ownerLng'
        ]);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny([
          'ownerPhone','latitude','longitude','currentLocation','ownerLat','ownerLng'
        ]));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Vehicle contact data is separated from the publicly readable vehicle listing.
    // Customers receive a phone only through getVehicleBookingContact after booking.
    match /vehicleOwnerContacts/{vehicleId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.phone is string;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.phone is string;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /fcmTokens/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      match /tokens/{tokenId} {
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /customers/{uid}/addresses/{addressId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /customers/{uid}/notifications/{notificationId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /customers/{uid}/wishlist/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /ridePartners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('role', '') == 'carrier'
        && request.resource.data.get('approvalStatus', '') == 'pending'
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('isOnline', false) == false
        && request.resource.data.get('availableForRides', false) == false;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('role', '') == 'carrier'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','fullName','displayName','email','phone','mobile','mobileNumber',
            'address','profilePhotoUrl','vehicleType','vehicleTypeUpdatedAt','vehicleNumber',
            'carrierLat','carrierLng','carrierLocationUpdatedAt','lastLocationAt','lastSeenAt','updatedAt'
          ]));
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /travelReviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
    }

    match /travelReports/{reportId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /notificationBroadcasts/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/banners {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/delivery {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/deliveryAssignment {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/ridePricing {
      // Ride fares are public so the customer can calculate/display the price
      // before submitting a ride request. Only the Admin can change them.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public catalog data. Product writes remain Admin-only.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/homepage {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public release metadata only; never store secrets here.
    match /settings/appUpdate {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serviceableZones/{pincode} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /deliveryPartners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('role', '') == 'delivery_partner'
        && request.resource.data.get('approvalStatus', '') == 'pending'
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('isOnline', false) == false
        && request.resource.data.get('availableForDeliveries', false) == false;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('role', '') == 'delivery_partner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','fullName','displayName','email','phone','mobile','mobileNumber',
            'address','profilePhotoUrl','vehicleType','vehicleTypeUpdatedAt','vehicleNumber',
            'deliveryLat','deliveryLng','lastLat','lastLng','deliveryLocationUpdatedAt',
            'lastLocationAt','lastSeenAt','updatedAt'
          ]));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && (
        request.resource.data.requesterId == request.auth.uid ||
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.userUid == request.auth.uid
      );
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.customerUid == request.auth.uid ||
          resource.data.userUid == request.auth.uid
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Legacy path is retained read-only for admins during migration.
    match /support_tickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sosAlerts/{alertId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /onboarding_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /sellers/{uid} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('role', 'customer') != 'admin');
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
          && request.resource.data.get('role', 'customer') != 'admin');
    }
  }
}