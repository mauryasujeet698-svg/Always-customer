rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com"; }

    match /orders/{orderId} {
      // Orders are created by the trusted createCustomerOrder callable only.
      allow create: if false;
      allow read: if isAdmin() || (signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.carrierUid == request.auth.uid ||
        resource.data.deliveryPartnerUid == request.auth.uid
      ));

      allow update: if isAdmin()
        || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','statusNote','cancellationReason','updatedAt'
          ])
          && resource.data.status in ['New Order','Confirmed']
          && request.resource.data.status == 'Cancelled')
        || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn() && resource.data.carrierUid == request.auth.uid
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.shiftStatus == 'on_duty'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carrierLat','carrierLng','carrierLocationUpdatedAt']));
      allow delete: if false;
    }


    match /rideBookings/{bookingId} {
      // A customer may only submit an unassigned request. Dispatch, assignment,
      // fare authority and protected ride state must be established server-side.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.get('status', 'searching') in ['searching', 'Searching', 'requested', 'pending', 'Pending']
        && request.resource.data.get('partnerUid', '') == ''
        && request.resource.data.get('driverUid', '') == ''
        && request.resource.data.get('carrierUid', '') == ''
        && request.resource.data.get('ridePinVerified', false) != true
        && request.resource.data.get('isAdmin', false) != true
        && request.resource.data.get('approved', false) != true;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','status',
            'cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status == 'Cancelled'
          ))
        || (signedIn() && resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','partnerAccepted','acceptedAt','rejectedAt','partnerLat','partnerLng',
            'partnerLocationUpdatedAt','cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && request.resource.data.status in ['pending_acceptance','Accepted','Rejected','Cancelled']);
      allow delete: if false;
    }

    match /autoRideRequests/{requestId} {
      function onlineRidePartner() {
        return signedIn()
          && exists(/databases/$(database)/documents/ridePartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.status == 'online'
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.vehicleType in ['bike','auto','car','two_wheeler'];
      }

      // Ride requests and initial confirmation PINs are created by the trusted callable only.
      allow create: if false;

      allow read: if isAdmin() || (signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.driverUid == request.auth.uid ||
        resource.data.carrierUid == request.auth.uid
      ));

      allow update: if isAdmin()
        || (signedIn() && (resource.data.customerUid == request.auth.uid || resource.data.customerId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','cancelledBy','cancellationReason','cancelledAt',
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt','customerActive'
          ])
          && (
            (request.resource.data.status == resource.data.status &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerLat','customerLng','customerLocationUpdatedAt','updatedAt'])) ||
            (request.resource.data.status == 'cancelled' && resource.data.status in ['searching','accepted'])
          ))
        || (signedIn() && (resource.data.driverUid == request.auth.uid || resource.data.carrierUid == request.auth.uid)
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.shiftStatus == 'on_duty'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverLat','driverLng','driverLocationUpdatedAt'
          ]));
      allow delete: if false;
    }

    match /vehicleBookings/{bookingId} {
      // Bind a vehicle booking to the actual owner of the listed vehicle. A
      // customer cannot forge another owner's identity or create a pre-accepted booking.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.get('status', '') == 'Booked'
        && request.resource.data.vehicleId is string
        && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId))
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerUid == request.resource.data.ownerUid
        && request.resource.data.keys().hasOnly([
          'vehicleId', 'ownerUid', 'ownerName', 'ownerPhone',
          'customerUid', 'customerName', 'customerEmail',
          'category', 'listedPrice', 'mode', 'status', 'createdAt'
        ]);
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerLat','ownerLng','ownerLocationUpdatedAt','status','updatedAt'
          ])
          && request.resource.data.status in ['Booked','Accepted','Rejected','Cancelled','delivered']);
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('isVerified', false) != true
        && request.resource.data.get('approved', false) != true
        && request.resource.data.get('verificationStatus', 'pending') != 'approved'
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('isAdmin', false) != true);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'listingStatus', 'available', 'updatedAt', 'price', 'pricePerKm',
          'capacity', 'imageUrl', 'vehicleImageUrl', 'allowNegotiation', 'description',
          'vehicleModel', 'vehicleColor', 'category', 'vehicleType'
        ])
        && request.resource.data.get('verified', resource.data.get('verified', false)) == resource.data.get('verified', false)
        && request.resource.data.get('isVerified', resource.data.get('isVerified', false)) == resource.data.get('isVerified', false)
        && request.resource.data.get('approvalStatus', resource.data.get('approvalStatus', 'pending')) == resource.data.get('approvalStatus', 'pending'));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /fcmTokens/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      match /tokens/{tokenId} {
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /customers/{uid}/addresses/{addressId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /customers/{uid}/notifications/{notificationId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /customers/{uid}/wishlist/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /partnerPublicPresence/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /customerPrivatePins/{pinId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /privacyRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.requestType in ['grievance','access','correction','erasure','location']
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 2000;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /rideOffers/{partnerUid}/requests/{rideId} {
      allow read: if signedIn() && request.auth.uid == partnerUid;
      allow update: if signedIn() && request.auth.uid == partnerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejected','rejectedAt'])
        && request.resource.data.get('rejected', false) == true;
      allow create, delete: if false;
    }

    match /ridePartners/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'carrier') != 'admin'
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('shiftStatus', 'off_duty') != 'on_duty';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','displayName','phone','mobileNumber','vehicleType','vehicleNumber',
            'vehicleColor','vehicleModel','photoUrl','updatedAt','profileUpdatedAt'
          ])
          && request.resource.data.get('role', resource.data.get('role', 'carrier')) == resource.data.get('role', 'carrier')
          && request.resource.data.get('approvalStatus', resource.data.get('approvalStatus', 'pending')) == resource.data.get('approvalStatus', 'pending'))
        || (signedIn() && request.auth.uid == uid && resource.data.shiftStatus == 'on_duty'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'carrierLat','carrierLng','carrierLocationUpdatedAt','lastLocationAt','lastSeenAt'
          ]));
      allow delete: if isAdmin();
    }

    match /travelReviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
    }

    match /travelReports/{reportId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /notificationBroadcasts/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/banners {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/delivery {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/deliveryAssignment {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/ridePricing {
      // Ride fares are public so the customer can calculate/display the price
      // before submitting a ride request. Only the Admin can change them.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public catalog data. Product writes remain Admin-only.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/homepage {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public release metadata only; never store secrets here.
    match /settings/appUpdate {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public app-update manifests contain only version, URL, digest and notes.
    match /settings/driverPartnerAppUpdate {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/deliveryPartnerAppUpdate {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serviceableZones/{pincode} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /deliveryPartners/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'delivery_partner') != 'admin'
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('shiftStatus', 'off_duty') != 'on_duty';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','displayName','phone','mobileNumber','vehicleType','vehicleNumber',
            'vehicleColor','vehicleModel','photoUrl','updatedAt','profileUpdatedAt'
          ])
          && request.resource.data.get('role', resource.data.get('role', 'delivery_partner')) == resource.data.get('role', 'delivery_partner')
          && request.resource.data.get('approvalStatus', resource.data.get('approvalStatus', 'pending')) == resource.data.get('approvalStatus', 'pending'))
        || (signedIn() && request.auth.uid == uid && resource.data.shiftStatus == 'on_duty'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveryLat','deliveryLng','lastLat','lastLng','deliveryLocationUpdatedAt','lastLocationAt','lastSeenAt'
          ]));
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && (
        request.resource.data.requesterId == request.auth.uid ||
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.userUid == request.auth.uid
      );
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.customerUid == request.auth.uid ||
          resource.data.userUid == request.auth.uid
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Legacy path is retained read-only for admins during migration.
    match /support_tickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sosAlerts/{alertId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /onboarding_requests/{requestId} {
      // A user may submit and maintain their own application, but must not be
      // able to mark it approved/verified or change its identity/role fields.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('role', 'customer') != 'admin'
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('status', 'pending') != 'approved'
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('isVerified', false) != true
        && request.resource.data.get('approved', false) != true
        && request.resource.data.get('verificationStatus', 'pending') != 'approved'
        && request.resource.data.get('isAdmin', false) != true;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'approvalStatus', 'status', 'approved', 'approvedAt', 'approvedBy',
          'verified', 'isVerified', 'verificationStatus', 'verifiedAt', 'verifiedBy',
          'rejectedAt', 'rejectedBy', 'reviewedAt', 'reviewedBy', 'isAdmin', 'accountStatus'
        ]));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /sellers/{uid} {
      // Seller roots can contain private owner details. The customer app does
      // not need unauthenticated access to these private records.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'seller') != 'admin'
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('status', 'pending') != 'approved'
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('isVerified', false) != true
        && request.resource.data.get('approved', false) != true
        && request.resource.data.get('verificationStatus', 'pending') != 'approved'
        && request.resource.data.get('isAdmin', false) != true);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'businessName', 'name', 'description', 'about', 'openingHours',
          'isOpen', 'items', 'updatedAt', 'photoUrl', 'logoUrl'
        ])
        && request.resource.data.get('approvalStatus', resource.data.get('approvalStatus', 'pending')) == resource.data.get('approvalStatus', 'pending')
        && request.resource.data.get('status', resource.data.get('status', 'pending')) == resource.data.get('status', 'pending')
        && request.resource.data.get('verified', resource.data.get('verified', false)) == resource.data.get('verified', false)
        && request.resource.data.get('isVerified', resource.data.get('isVerified', false)) == resource.data.get('isVerified', false));
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() <= 120
          && request.resource.data.get('details', '') is string
          && request.resource.data.get('details', '').size() <= 1000
          && request.resource.data.get('active', true) is bool);
        allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'details', 'active', 'updatedAt'
          ])
          && request.resource.data.get('title', resource.data.get('title', '')) is string
          && request.resource.data.get('title', resource.data.get('title', '')).size() <= 120
          && request.resource.data.get('details', resource.data.get('details', '')) is string
          && request.resource.data.get('details', resource.data.get('details', '')).size() <= 1000
          && request.resource.data.get('active', true) is bool);
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'customer') != 'admin'
        && request.resource.data.get('isAdmin', false) != true
        && request.resource.data.get('approvalStatus', 'pending') != 'approved'
        && request.resource.data.get('isVerified', false) != true;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'email', 'phone', 'mobileNumber',
            'photoUrl', 'photoURL', 'profilePhotoUrl', 'avatarUrl',
            'address', 'defaultAddress', 'city', 'state', 'pincode', 'postalCode',
            'updatedAt', 'profileUpdatedAt', 'lastSeenAt'
          ])
          && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
          && request.resource.data.get('role', 'customer') != 'admin');

      match /travelFavorites/{favoriteId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}