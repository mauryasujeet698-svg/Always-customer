rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com";
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcmTokens/{userId}/tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /deliveryPartners/{userId} {
      allow read: if signedIn();

      // A partner may create a profile, but cannot self-assign approval.
      // Approval changes must be performed by the admin.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('approvalStatus' in request.resource.data) ||
          request.resource.data.approvalStatus == 'pending')
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['approvalStatus'])
      );
      allow delete: if isAdmin();
    }

    match /ridePartners/{userId} {
      allow read: if signedIn();

      // Keep ride-partner approval server/admin controlled as well.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('approvalStatus' in request.resource.data) ||
          request.resource.data.approvalStatus == 'pending')
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['approvalStatus'])
      );
      allow delete: if isAdmin();
    }

    match /autoRideRequests/{rideId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterRole in ['customer','carrier','delivery_partner'];
      allow read: if isAdmin() || (signedIn() && resource.data.requesterId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.requesterId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message','updatedAt']));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
