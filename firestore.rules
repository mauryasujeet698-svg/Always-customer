rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com";
    }

    // Customer catalog is intentionally readable without login so the shop
    // can display products before authentication.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcmTokens/{userId}/tokens/{tokenId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
