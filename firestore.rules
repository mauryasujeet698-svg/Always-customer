rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com"; }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.carrierUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.approvalStatus == 'approved'
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.status == 'online'
          && resource.data.carrierUid == null) ||
        isAdmin()
      );

      allow update: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid
          && resource.data.status in ['New Order', 'Confirmed']
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusNote', 'cancellationReason', 'updatedAt']))
        || (signedIn() && resource.data.carrierUid == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'carrierUid','assignedPartnerId','carrierName','carrierPhone','carrierAccepted','assignmentRejected',
            'assignmentAttempts','status','statusNote','customerMessage','carrierLat',
            'carrierLng','carrierLocationUpdatedAt','deliveryOtpVerified','updatedAt'
          ])
          && (
            request.resource.data.carrierUid == request.auth.uid ||
            (request.resource.data.status == 'unassigned' && request.resource.data.carrierUid == null)
          )
          && request.resource.data.status in ['pending_acceptance','Assigned','Confirmed','Picked up','Out for delivery','Delivered','unassigned'])
        || (signedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn()
          && exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.approvalStatus == 'approved'
          && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.status == 'online'
          && resource.data.carrierUid == null
          && request.resource.data.carrierUid == request.auth.uid
          && request.resource.data.deliveryPartnerUid == request.auth.uid
          && request.resource.data.status == 'Assigned'
          && request.resource.data.carrierAccepted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'carrierUid','deliveryPartnerUid','carrierName','carrierPhone','carrierVehicleType',
            'carrierAccepted','assignedAt','status','updatedAt'
          ]));

      allow delete: if false;
    }


    match /rideBookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','status',
            'cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status == 'Cancelled'
          ))
        || (signedIn() && resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','partnerAccepted','acceptedAt','rejectedAt','partnerLat','partnerLng',
            'partnerLocationUpdatedAt','cancelledBy','cancellationReason','cancelledAt','updatedAt'
          ])
          && request.resource.data.status in ['pending_acceptance','Accepted','Rejected','Cancelled']);
      allow delete: if false;
    }

    match /autoRideRequests/{requestId} {
      function onlineRidePartner() {
        return signedIn()
          && exists(/databases/$(database)/documents/ridePartners/$(request.auth.uid))
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.status == 'online'
          && get(/databases/$(database)/documents/ridePartners/$(request.auth.uid)).data.vehicleType in ['bike','auto','two_wheeler'];
      }

      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.rejectedBy is list;

      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.driverUid == request.auth.uid ||
        isAdmin() ||
        onlineRidePartner()
      );

      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','cancelledBy','cancellationReason','cancelledAt',
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ])
          && request.resource.data.status in ['searching','accepted','started','cancelled','completed'])
        || (signedIn() && resource.data.driverUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','driverUid','driverName','driverPhone','driverVehicleType','acceptedAt',
            'driverLat','driverLng','driverLocationUpdatedAt','rejectedBy','updatedAt',
            'cancelledBy','cancellationReason','cancelledAt'
          ])
          && request.resource.data.status in ['accepted','started','completed','cancelled'])
        || (onlineRidePartner()
          && resource.data.status == 'searching'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejectedBy','updatedAt'])
          && request.resource.data.rejectedBy is list)
        || (onlineRidePartner()
          && resource.data.status == 'searching'
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','driverUid','driverName','driverPhone','driverVehicleType','acceptedAt','updatedAt'
          ]));

      allow delete: if false;
    }

    match /vehicleBookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt'
          ]))
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerLat','ownerLng','ownerLocationUpdatedAt','updatedAt'
          ]));
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /fcmTokens/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      match /tokens/{tokenId} {
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn();
      }
    }

    match /customers/{uid}/addresses/{addressId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /customers/{uid}/wishlist/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /ridePartners/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('role', 'customer') != 'admin');
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
          && request.resource.data.get('role', 'customer') != 'admin'
          && (request.resource.data.status != 'online' || request.resource.data.approvalStatus == 'approved'));
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /travelReviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
    }

    match /travelReports/{reportId} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /notificationBroadcasts/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/banners {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/deliveryAssignment {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Public catalog data. Product writes remain Admin-only.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/homepage {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deliveryPartners/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('role', 'customer') != 'admin');
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
          && request.resource.data.get('role', 'customer') != 'admin'
          && (request.resource.data.status != 'online' || request.resource.data.approvalStatus == 'approved'));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /sosAlerts/{alertId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /onboarding_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /sellers/{uid} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('role', 'customer') != 'admin');
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
          && request.resource.data.get('role', 'customer') != 'admin');
    }
  }
}