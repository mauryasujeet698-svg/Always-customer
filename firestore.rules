rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "mauryasujeet698@gmail.com";
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcmTokens/{userId}/tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      // Orders are private. Customers, assigned delivery/ride partners, and Admin only.
      allow create: if signedIn()
        && (request.resource.data.get('customerId', '') == request.auth.uid
          || request.resource.data.get('customerUid', '') == request.auth.uid);
      allow read: if isAdmin() || (signedIn() && (
        resource.data.get('customerId', '') == request.auth.uid
        || resource.data.get('customerUid', '') == request.auth.uid
        || resource.data.get('carrierUid', '') == request.auth.uid
        || resource.data.get('deliveryPartnerUid', '') == request.auth.uid
      ));
      allow update: if isAdmin()
        || (signedIn()
          && (resource.data.get('customerId', '') == request.auth.uid
            || resource.data.get('customerUid', '') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','statusNote','cancellationReason','updatedAt','customerLat',
            'customerLng','customerLocationUpdatedAt','rating','ratedAt'
          ])
          && (
            request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'Cancelled'
              && resource.data.status in ['New Order','Confirmed','Pending','pending'])
          )
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating','ratedAt'])
            || (request.resource.data.rating is number
              && request.resource.data.rating >= 1
              && request.resource.data.rating <= 5
              && resource.data.status in ['Delivered','delivered','Completed','completed'])))
        || (signedIn()
          && (resource.data.get('carrierUid', '') == request.auth.uid
            || resource.data.get('deliveryPartnerUid', '') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'carrierLat','carrierLng','carrierLocationUpdatedAt',
            'deliveryPartnerLat','deliveryPartnerLng','deliveryPartnerLocationUpdatedAt','updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Customer-owned subcollections (addresses, favourites, preferences, etc.)
    // are not covered by the parent-document match in Firestore rules.
    match /customers/{userId}/{subcollection}/{documentId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /deliveryPartners/{userId} {
      allow read: if isOwner(userId) || isAdmin(); 
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /ridePartners/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /autoRideRequests/{rideId} {
      // Ride request records may contain precise locations and verification PINs.
      // Ride discovery should use per-partner rideOffers projections instead.
      allow create: if signedIn()
        && (request.resource.data.get('customerUid', '') == request.auth.uid
          || request.resource.data.get('customerId', '') == request.auth.uid)
        && request.resource.data.get('status', '') == 'searching';
      allow read: if isAdmin() || (signedIn() && (
        resource.data.get('customerUid', '') == request.auth.uid
        || resource.data.get('customerId', '') == request.auth.uid
        || resource.data.get('driverUid', '') == request.auth.uid
        || resource.data.get('carrierUid', '') == request.auth.uid
      ));
      allow update: if isAdmin()
        || (signedIn()
          && (resource.data.get('customerUid', '') == request.auth.uid
            || resource.data.get('customerId', '') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','cancelledBy','cancellationReason','cancelledAt','customerActive',
            'customerLat','customerLng','customerLocationUpdatedAt','updatedAt','expiredAt'
          ])
          && (
            request.resource.data.status == resource.data.status
            || (request.resource.data.status in ['cancelled','Cancelled']
              && resource.data.status in ['searching','requested','accepted','assigned','arriving','arrived','started','New Order','Confirmed'])
            || (request.resource.data.status == 'expired'
              && resource.data.get('expiresAt', null) is timestamp
              && resource.data.expiresAt <= request.time)
          ))
        || (signedIn()
          && (resource.data.get('driverUid', '') == request.auth.uid
            || resource.data.get('carrierUid', '') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverLat','driverLng','driverLocationUpdatedAt','updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterRole in ['customer','carrier','delivery_partner'];
      allow read: if isAdmin() || (signedIn() && resource.data.requesterId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.requesterId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message','updatedAt']));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
