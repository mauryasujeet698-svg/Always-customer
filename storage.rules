rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "mauryasujeet@gmail.com";
    }

    // Public assets only. KYC files must never be placed under this path.
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null ||
          (request.resource.size < 5 * 1024 * 1024 &&
           request.resource.contentType.matches('image/.*')));
    }

    // Identity / vehicle documents are private. Only the owner and admin can read.
    match /onboarding/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && (request.resource == null ||
          (request.resource.size < 10 * 1024 * 1024 &&
           request.resource.contentType.matches('(image/.*|application/pdf)')));
    }

    // Seller media is private by default. Serve public catalog imagery from a
    // dedicated public media path/provider rather than mixing it with KYC uploads.
    match /sellers/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && (request.resource == null ||
          (request.resource.size < 10 * 1024 * 1024 &&
           request.resource.contentType.matches('(image/.*|application/pdf)')));
    }
  }
}
